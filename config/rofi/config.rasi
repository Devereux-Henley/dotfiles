configuration {
    modes:                "drun,run,window";
    show-icons:           true;
    drun-display-format:  "{name}";
    font:                 "monospace 12";
    display-drun:         "Apps";
    display-run:          "Run";
    display-window:       "Windows";
}

@theme "~/.config/rofi/grothmar.rasi"
